# Local (Docker Compose):
# DATABASE_URL="postgresql://kyubi:kyubi@localhost:5432/kyubi?schema=public"
# Supabase (producción):
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?sslmode=require"
JWT_SECRET="replace-with-a-random-32-byte-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS="30"
# Orígenes permitidos por CORS (separados por coma). NO uses `*`: en producción
# se exige una whitelist explícita (CORS con credenciales requiere origen exacto).
# Ej: https://app.kyubi.social,https://kyubi.social
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kyubi Social <no-reply@kyubi.local>"

# ── Almacenamiento en la nube (S3-compatible: AWS S3 / Cloudflare R2) ──────
# STORAGE_DRIVER: 's3' (nube) o 'local' (respaldo dev). Si se omite, se usa
# 's3' cuando existen credenciales S3 y 'local' en caso contrario.
STORAGE_DRIVER="s3"
S3_BUCKET="kyubi-media"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Obligatorio para Cloudflare R2 (S3-compatible). Opcional para AWS S3.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# URL pública/custom domain del bucket (CDN). Si se omite se deriva del bucket.
S3_PUBLIC_URL=""
# Alternativa: Cloudinary (driver 's3' con CLOUDINARY_URL no se usa; para
# Cloudinary usa su SDK y define CLOUDINARY_URL aquí). Reservado.
CLOUDINARY_URL=""
# Optimización de imágenes con sharp (por defecto WebP 1600px @ q82).
IMAGE_MAX_WIDTH="1600"
IMAGE_QUALITY="82"

# ── Firebase Cloud Messaging (notificaciones push) ─────────────────────────
# Opción A: credenciales de cuenta de servicio (Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar clave privada).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@kyubi.iam.gserviceaccount.com"
# IMPORTANTE: conservar los \n literales del JSON de la clave privada.
FIREBASE_PRIVATE_KEY=""
# Opción B: ruta absoluta al JSON de la cuenta de servicio.
GOOGLE_APPLICATION_CREDENTIALS=""
