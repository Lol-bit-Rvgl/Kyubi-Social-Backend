generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  CIRCLE
  PRIVATE_LINK
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  ADULT_CONTENT
  SPOILERS
  IMPERSONATION
  COPYRIGHT
  SELF_HARM
  OTHER
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  WALL_ENTRY
  MESSAGE
  CIRCLE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  OWNER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationAction {
  MUTE_USER
  UNMUTE_USER
  BAN_USER
  UNBAN_USER
  DELETE_POST
  DELETE_CIRCLE
  DELETE_SALA
  REVIEW_REPORT
  RESOLVE_REPORT
  DISMISS_REPORT
  CHANGE_ROLE
  // ── Panel de moderación (nuevas acciones) ──
  WARN
  SUSPEND_USER
  UNSUSPEND_USER
  HIDE_POST
  UNHIDE_POST
  HIDE_COMMENT
  UNHIDE_COMMENT
  HIDE_MESSAGE
  UNHIDE_MESSAGE
  PIN_POST
  UNPIN_POST
  FEATURE_POST
  UNFEATURE_POST
  HIDE_PROFILE
  UNHIDE_PROFILE
  ASSIGN_TITLE
  REMOVE_TITLE
}

enum ModerationTargetType {
  USER
  POST
  CIRCLE
  ROOM
  REPORT
  COMMENT
  MESSAGE
}

enum CircleRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoomStatus {
  ACTIVE
  ENDED
}

enum RoomAccess {
  PUBLIC
  PRIVATE
}

enum RoomKind {
  SOCIAL
}

/// Tipo de contenido de un mensaje de sala (RoomMessage).
enum RoomMessageType {
  TEXT
  VOICE
  IMAGE
  POLL
  SYSTEM
  DICE
  RPS
}

enum NotificationType {
  FOLLOW
  REACTION
  COMMENT
  MENTION
  WALL
  MODERATION_WARNING
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

/// Estado de una solicitud de seguimiento (follow con aprobación).
enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  username                String               @unique
  passwordHash            String?
  googleId                String?              @unique
  displayName             String?
  avatarUrl               String?
  bannerUrl               String?
  bio                     String?              @db.VarChar(500)
  emailVerifiedAt         DateTime?
  role                    UserRole             @default(USER)
  onboardingCompleted     Boolean              @default(false)
  usernameColor           String?
  avatarFrame             String?
  level                   Int                  @default(1)
  isOnline                Boolean              @default(false)
  gender                  String?
  showGender              Boolean              @default(true)
  stickers                String[]             @default([])
  interests               String[]             @default([])
  socialLinks             Json?
  voiceBioUrl             String?
  hasPaymentPassword      Boolean              @default(false)
  paymentPasswordHash     String?
  availability            Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  posts                   Post[]
  refreshTokens           RefreshToken[]
  reactions               Reaction[]
  following               Follow[]             @relation("Following")
  followers               Follow[]             @relation("Followers")
  verificationTokens      VerificationToken[]
  comments                Comment[]
  commentReactions        CommentReaction[]
  visitsMade              ProfileVisit[]       @relation("Visitor")
  visitsReceived          ProfileVisit[]       @relation("Visited")
  drafts                  Draft[]
  wallOwned               WallEntry[]          @relation("WallOwned")
  wallAuthored            WallEntry[]          @relation("WallAuthor")
  wallLikes               WallLike[]
  conversationMemberships ConversationMember[]
  messagesSent            Message[]
  reportsMade             Report[]             @relation("ReportAuthor")
  notifications           Notification[]       @relation("NotificationsReceived")
  notificationsAuthored   Notification[]       @relation("NotificationsAuthored")
  circlesCreated          Circle[]             @relation("CircleCreator")
  circleMemberships       CircleMember[]
  roomsHosted             Room[]               @relation("RoomHost")
  roomParticipations      RoomParticipant[]
  roomMessages            RoomMessage[]
  characters              Character[]
  mutesReceived           Mute[]               @relation("MutedUser")
  mutesIssued             Mute[]               @relation("MuteModerator")
  bansReceived            Ban[]                @relation("BannedUser")
  bansIssued              Ban[]                @relation("BanModerator")
  moderationActions       ModerationLog[]      @relation("ModeratorAction")
  reportsHandled          Report[]             @relation("ReportHandler")
  reportsReceived         Report[]             @relation("ReportedUser")
  logsAsTargetUser        ModerationLog[]      @relation("LogTargetUser")
  postsHidden             Post[]               @relation("PostHiddenBy")

  // ── Moderación del perfil (panel de moderación) ──
  isSuspended     Boolean   @default(false) @map("is_suspended")
  suspendedUntil  DateTime? @map("suspended_until")
  isProfileHidden Boolean   @default(false) @map("is_profile_hidden")
  moderationNotes String?   @map("moderation_notes")

  titles                 UserTitle[]
  deviceTokens           DeviceToken[]
  stories                Story[]
  storyViews             StoryView[]
  bookmarks              Bookmark[]
  assignedRoleSlots      RoleSlot[]
  followRequestsMade     FollowRequest[] @relation("FollowRequestsMade")
  followRequestsReceived FollowRequest[] @relation("FollowRequestsReceived")
}

/// Token FCM de un dispositivo registrado para notificaciones push.
model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("unknown") // android | ios | web | unknown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Solicitud de seguimiento pendiente de aprobación (follow con aprobación).
model FollowRequest {
  id          String              @id @default(cuid())
  requesterId String
  targetId    String
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  respondedAt DateTime?
  requester   User                @relation("FollowRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User                @relation("FollowRequestsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@index([requesterId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TokenType @default(EMAIL_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
}

model Post {
  id             String         @id @default(cuid())
  authorId       String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String         @db.VarChar(10000)
  title          String?        @db.VarChar(300)
  type           String         @default("TEXT")
  visibility     PostVisibility @default(PUBLIC)
  coverImageUrl  String?
  bgImageUrl     String?
  bgOverlay      Float          @default(0.55)
  bgBlur         Boolean        @default(false)
  tags           String[]       @default([])
  genres         String[]       @default([])
  mediaUrls      String[]       @default([])
  audioUrl       String?
  views          Int            @default(0)
  shares         Int            @default(0)
  chapterMode    Boolean        @default(false)
  chapterNumber  Int?
  fontFamily     String?
  themeBgColor   String?
  themeAccent    String?
  warnViolence   Boolean        @default(false)
  warnAdult      Boolean        @default(false)
  warnDark       Boolean        @default(false)
  warnSpoiler    Boolean        @default(false)
  allowComments  Boolean        @default(true)
  allowReactions Boolean        @default(true)

  // ── Moderación y curaduría del panel ──
  isPinned       Boolean   @default(false) @map("is_pinned")
  pinnedAt       DateTime? @map("pinned_at")
  isHidden       Boolean   @default(false) @map("is_hidden")
  hiddenReason   String?   @map("hidden_reason")
  hiddenByUserId String?   @map("hidden_by_user_id")
  hiddenBy       User?     @relation("PostHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)
  featuredUntil  DateTime? @map("featured_until")

  // ── Roleplay / OCs ──
  characterId        String? @db.VarChar(64)
  characterName      String? @db.VarChar(80)
  characterAvatarUrl String?

  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reactions   Reaction[]
  comments    Comment[]
  bookmarks   Bookmark[]
  roleSlots   RoleSlot[]
  circleId    String?
  circle      Circle?    @relation(fields: [circleId], references: [id], onDelete: Cascade)

  moderationLogs ModerationLog[] @relation("LogTargetPost")

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([isPinned])
  @@index([isHidden])
  @@index([featuredUntil])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

/// Vacante de rol en una publicación de roleplay. Un slot puede estar abierto
/// (buscando intérprete) o asignado a un usuario/OC concreto.
model RoleSlot {
  id                  String   @id @default(cuid())
  postId              String
  title               String   @db.VarChar(120)
  description         String?  @db.VarChar(2000)
  requirements        String?  @db.VarChar(1000)
  isOpen              Boolean  @default(true)
  assignedCharacterId String?
  assignedUserId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  post              Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  assignedCharacter Character? @relation(fields: [assignedCharacterId], references: [id], onDelete: SetNull)
  assignedUser      User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([assignedUserId])
}

model Reaction {
  id     String       @id @default(cuid())
  postId String
  userId String
  type   ReactionType @default(LIKE)
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String  @id @default(cuid())
  postId    String
  userId    String
  body      String  @db.VarChar(4000)
  parentId  String?
  mediaUrl  String?
  mediaType String?
  isEdited  Boolean @default(false)

  // ── Moderación (panel) ──
  isHidden     Boolean @default(false) @map("is_hidden")
  hiddenReason String? @map("hidden_reason")

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType @default(LIKE)
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model ProfileVisit {
  id        String   @id @default(cuid())
  visitorId String
  visitedId String
  visitor   User     @relation("Visitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visited   User     @relation("Visited", fields: [visitedId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([visitorId, visitedId])
  @@index([visitedId, visitedAt])
}

model Draft {
  id        String   @id @default(cuid())
  userId    String
  snapshot  Json
  postId    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

model WallEntry {
  id        String      @id @default(cuid())
  ownerId   String
  authorId  String
  body      String      @db.VarChar(4000)
  imageUrl  String?
  parentId  String?
  owner     User        @relation("WallOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  author    User        @relation("WallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    WallEntry?  @relation("WallReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   WallEntry[] @relation("WallReplies")
  likes     WallLike[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ownerId, createdAt])
  @@index([parentId])
}

model WallLike {
  id      String       @id @default(cuid())
  entryId String
  userId  String
  type    ReactionType @default(LIKE)
  entry   WallEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
}

model Conversation {
  id        String               @id @default(cuid())
  type      ConversationType     @default(DIRECT)
  title     String?              @db.VarChar(120)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id                String       @id @default(cuid())
  conversationId    String
  userId            String
  role              String       @default("MEMBER")
  lastReadMessageId String?
  lastReadAt        DateTime?
  muted             Boolean      @default(false)
  joinedAt          DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage   Message?     @relation("MessageLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  senderId       String
  body           String  @db.VarChar(4000)
  mediaUrl       String?
  mediaType      String?
  replyToId      String?

  // ── Roleplay / OCs ──
  characterId        String? @db.VarChar(64)
  characterName      String? @db.VarChar(80)
  characterAvatarUrl String?
  extensions         Json    @default("{}")

  editedAt  DateTime?
  deletedAt DateTime?

  // ── Moderación (panel) ──
  isHidden     Boolean @default(false) @map("is_hidden")
  hiddenReason String? @map("hidden_reason")

  createdAt    DateTime             @default(now())
  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?             @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]            @relation("MessageReply")
  readBy       ConversationMember[] @relation("MessageLastRead")

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  reason          ReportReason
  details         String?          @db.VarChar(2000)
  targetType      ReportTargetType
  targetId        String
  status          ReportStatus     @default(OPEN)
  handledById     String?
  handledBy       User?            @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  resolutionNote  String?          @db.VarChar(2000)
  resolutionNotes String?          @map("resolution_notes") @db.VarChar(2000)
  resolvedAt      DateTime?
  // ── Usuario autor del recurso denunciado (para el centro de reportes) ──
  reportedUserId  String?          @map("reported_user_id")
  reportedUser    User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reporter        User             @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@index([reportedUserId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  actorId    String?
  type       NotificationType
  targetType String?
  targetId   String?
  text       String?          @db.VarChar(500)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("NotificationsAuthored", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, type])
}

model Circle {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(600)
  avatarUrl   String?
  bannerUrl   String?
  isPrivate   Boolean        @default(false)
  creatorId   String
  creator     User           @relation("CircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     CircleMember[]
  posts       Post[]
  rooms       Room[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdAt])
}

model CircleMember {
  id       String     @id @default(cuid())
  circleId String
  userId   String
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  circle   Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

model Room {
  id           String            @id @default(cuid())
  name         String            @db.VarChar(80)
  description  String?           @db.VarChar(600)
  imageUrl     String?
  /// Fondo de pantalla del chat (wallpaper) persistido para la sala.
  chatBackgroundUrl String?
  /// Reglas de convivencia personalizadas de la sala (máx 10 reglas de máx 140 chars c/u).
  rules             String[]          @default([])
  hostId       String
  /// Estado del cine sincronizado (Sala de Cine / Screening):
  cinemaVideoId   String?
  cinemaState     String?   @default("STOPPED")
  cinemaCurrentTime Float?  @default(0.0)
  cinemaUpdatedAt   DateTime?
  /// Modo interactivo activo en la sala (persistido para que los usuarios que
  /// entran después vean la actividad en curso): 'standard' | 'voice' | 'roleplay' | 'screening'.
  currentMode     String    @default("standard")
  /// Roles del stage de roleplay configurados y asignados en la sala.
  stageRoles      Json      @default("[]")
  host         User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  status       RoomStatus        @default(ACTIVE)
  access       RoomAccess        @default(PUBLIC)
  kind         RoomKind          @default(SOCIAL)
  capacity     Int?
  circleId     String?
  circle       Circle?           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
  messages     RoomMessage[]
  createdAt    DateTime          @default(now())
  endedAt      DateTime?

  @@index([status, createdAt])
  @@index([circleId])
}

model RoomMessage {
  id       String @id @default(cuid())
  roomId   String
  senderId String

  /// Tipo de contenido: texto, voz, imagen o encuesta.
  type RoomMessageType @default(TEXT)

  /// Texto del mensaje o URL del contenido multimedia (voz/imagen).
  body String @db.VarChar(4000)

  // ── Roleplay / OCs ──
  characterId        String? @db.VarChar(64)
  characterName      String? @db.VarChar(80)
  characterAvatarUrl String?

  // ── Payload / metadatos (duración de audio, opciones y votos de encuestas) ──
  extensions Json @default("{}")

  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([characterId])
}

/// Ficha de Personaje / OC (Original Character) para roleplay.
model Character {
  id          String  @id @default(cuid())
  userId      String
  name        String  @db.VarChar(60)
  alias       String? @db.VarChar(40)
  tagline     String? @db.VarChar(140)
  avatarUrl   String?
  bannerUrl   String?
  description String? @db.VarChar(2000)
  lore        String? @db.Text
  appearance  String? @db.Text

  // Listas de etiquetas libres serializadas como JSON.
  abilities  Json @default("[]")
  weaknesses Json @default("[]")
  universes  Json @default("[]")
  genres     Json @default("[]")

  faceClaim     String? @db.VarChar(120)
  voiceClaim    String? @db.VarChar(120)
  powerLevel    Int     @default(1)
  roleplayLevel String  @default("Novato") @db.VarChar(24)
  themeColor    String? @db.VarChar(9)
  themeAccent   String? @db.VarChar(9)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleSlots RoleSlot[]

  @@index([userId, createdAt])
}

model RoomParticipant {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  role     String    @default("PARTICIPANT")
  /// Metadatos del participante (ej: activeCharacter).
  metadata Json      @default("{}")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

/// Historia efímera de 24 horas (stories) asociada a un usuario.
model Story {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType StoryMediaType @default(IMAGE)
  caption   String?        @db.VarChar(500)
  createdAt DateTime       @default(now())
  expiresAt DateTime
  views     StoryView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Registro de visualización de una historia por un usuario.
model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model Mute {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String
  reason      String?   @db.VarChar(1000)
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())
  user        User      @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User      @relation("MuteModerator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([moderatorId])
  @@index([createdAt])
}

model Ban {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String
  reason      String?   @db.VarChar(1000)
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User      @relation("BanModerator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([moderatorId])
  @@index([createdAt])
}

model ModerationLog {
  id           String               @id @default(cuid())
  moderatorId  String
  action       ModerationAction
  targetType   ModerationTargetType
  targetId     String
  // ── FKs dedicadas del panel de moderación ──
  targetUserId String?              @map("target_user_id")
  targetUser   User?                @relation("LogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetPostId String?              @map("target_post_id")
  targetPost   Post?                @relation("LogTargetPost", fields: [targetPostId], references: [id], onDelete: SetNull)
  reason       String?              @db.VarChar(1000)
  metadata     Json?
  createdAt    DateTime             @default(now())
  moderator    User                 @relation("ModeratorAction", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([moderatorId, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([targetPostId])
  @@index([createdAt])
}

/// Título / etiqueta visible en el perfil de un usuario (ej: 'VIP', 'Ganador Torneo').
model UserTitle {
  id           String   @id @default(cuid())
  userId       String
  titleText    String   @map("title_text") @db.VarChar(80)
  colorHex     String   @map("color_hex") @db.VarChar(9)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
}

/// Token y código OTP para recuperación híbrida de contraseña.
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  code      String   // Código numérico de 6 dígitos
  token     String   @unique // Token seguro para deep link
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([token])
}

