# Local (Docker Compose):
# DATABASE_URL="postgresql://kyubi:kyubi@localhost:5432/kyubi?schema=public"
# Supabase (producción):
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?sslmode=require"
# Conexión directa (puerto 5432, sin pooler) — usada por `prisma migrate`.
# Local: misma URL que DATABASE_URL. Supabase: db.PROJECT_REF.supabase.co:5432
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-random-32-byte-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS="30"
# Orígenes permitidos por CORS (separados por coma). NO uses `*`: en producción
# se exige una whitelist explícita (CORS con credenciales requiere origen exacto).
# Ej: https://app.kyubi.social,https://kyubi.social
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kyubi Social <no-reply@kyubi.local>"

# ── Supabase Storage (RECOMENDADO: mismo proveedor que la BD) ───────────────
# Driver 'supabase' = API nativa de @supabase/supabase-js (evita firmas SigV4).
# 1) Supabase Dashboard → Storage → "New bucket" → nombre "uploads", marcado PÚBLICO.
# 2) Project Settings → API → copia tu Project URL y la Service Role Key.
# 3) Sustituye PROJECT_REF por el ref del proyecto.
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET (default 'uploads') — el bucket debe existir y ser público.
SUPABASE_BUCKET="uploads"

# ── Almacenamiento en la nube alternativo (S3-compatible: AWS S3 / R2) ──────
# Si prefieres AWS S3 / Cloudflare R2 en vez de Supabase, usa:
# STORAGE_DRIVER="s3"
# S3_BUCKET="kyubi-media"
# S3_REGION="us-west-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""                       # Obligatorio para R2
# S3_FORCE_PATH_STYLE="true"           # Obligatorio para R2/Supabase-S3
# S3_PUBLIC_URL=""                     # URL pública/CDN del bucket
CLOUDINARY_URL=""
# Optimización de imágenes con sharp (por defecto WebP 1600px @ q82).
IMAGE_MAX_WIDTH="1600"
IMAGE_QUALITY="82"

# ── Firebase Cloud Messaging (notificaciones push) ─────────────────────────
# Opción A: credenciales de cuenta de servicio (Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar clave privada).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@kyubi.iam.gserviceaccount.com"
# IMPORTANTE: conservar los \n literales del JSON de la clave privada.
FIREBASE_PRIVATE_KEY=""
# Opción B: ruta absoluta al JSON de la cuenta de servicio.
GOOGLE_APPLICATION_CREDENTIALS=""
